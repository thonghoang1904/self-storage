# Dia chi backend ASP.NET Core ma Vite chuyen tiep /api toi khi chay npm run dev
# (doi trong .env.development.local neu backend chay o cong khac)
BACKEND_URL=http://localhost:5080

# De trong khi phat trien: frontend goi /api qua proxy cua Vite, khong lo loi CORS.
# Khi build ban that, dat VITE_API_URL thanh dia chi backend, vd https://api.example.com
VITE_API_URL=
